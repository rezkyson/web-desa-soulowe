# Supabase, Fase 2. Salin menjadi .env dan isi nilainya.
# Jangan pernah commit .env (sudah ada di .gitignore).

# URL project, aman untuk browser.
PUBLIC_SUPABASE_URL=https://PROJECT-REF.supabase.co

# Publishable/anon key, aman untuk browser karena dilindungi RLS.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# HANYA server. Melewati RLS sepenuhnya. Jangan pernah dikirim ke browser,
# jangan dipakai untuk melayani request pengguna, jangan masuk log.
SUPABASE_SERVICE_ROLE_KEY=
